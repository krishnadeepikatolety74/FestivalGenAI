# Database Configuration
# Update with your MySQL connection string
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/festival_db

# Groq API Key (required)
# Get from https://console.groq.com/
GROQ_API_KEY=

# Gemini API key for image generation only
# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.0-flash-exp

# Flask Configuration
FLASK_ENV=development
NODE_ENV=development
PORT=5000

# Session Configuration
# Change this to a random string in production
SESSION_SECRET=your-secret-key-change-in-production

# Optional: OAuth Server URL (if using external OAuth)
OAUTH_SERVER_URL=

# Optional: App Configuration
VITE_APP_ID=
JWT_SECRET=
OWNER_OPEN_ID=
VITE_OAUTH_PORTAL_URL=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
VITE_APP_TITLE=FestivalGen AI
VITE_APP_LOGO=
